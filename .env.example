# Copy to .env and fill in. Never commit the real .env file.

# --- Discord ---
DISCORD_BOT_TOKEN=
# One JSON array entry per Discord server this bot instance should serve.
# One Spotify account can own several playlists, so no extra Spotify OAuth
# setup is needed per server - just add another {..} entry here with a
# different guild_id and spotify_playlist_id. monitored_channel_ids and
# admin_role_ids may be omitted/empty ([]).
#
# GUILDS=[
#   {"guild_id": 111111111111111111, "monitored_channel_ids": [222222222222222222], "spotify_playlist_id": "PLAYLIST_ID_ONE", "admin_role_ids": []},
#   {"guild_id": 333333333333333333, "monitored_channel_ids": [444444444444444444], "spotify_playlist_id": "PLAYLIST_ID_TWO", "admin_role_ids": [555555555555555555]}
# ]
#
# Must be valid JSON on a single line in the real .env file (the example
# above is wrapped across lines for readability only).
GUILDS=[]

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Odesli / song.link (optional key raises the ~10 req/min unkeyed limit) ---
ODESLI_API_KEY=

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Behaviour ---
EXPAND_ALBUMS=false
EXPAND_EPISODES=false
ALLOW_BOT_AUTHORS=false
MATCH_THRESHOLD=0.85
SCAN_STRATEGY=search              # search | history
DRY_RUN_DEFAULT=true

# --- Storage / logging ---
DATABASE_PATH=./data/cratebot.db
LOG_LEVEL=INFO

# Copy to .env and fill in. Never commit the real .env file.

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MONITORED_CHANNEL_IDS=            # comma-separated channel IDs
ADMIN_ROLE_IDS=                   # comma-separated role IDs, optional

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_PLAYLIST_ID=

# --- Odesli / song.link (optional key raises the ~10 req/min unkeyed limit) ---
ODESLI_API_KEY=

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Behaviour ---
EXPAND_ALBUMS=false
EXPAND_EPISODES=false
ALLOW_BOT_AUTHORS=false
MATCH_THRESHOLD=0.85
SCAN_STRATEGY=search              # search | history
DRY_RUN_DEFAULT=true

# --- Storage / logging ---
DATABASE_PATH=./data/cratebot.db
LOG_LEVEL=INFO
